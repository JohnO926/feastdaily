# Copy to .env.local for `npm run dev`. Never commit real secrets.

# Postgres. Locally: docker compose (postgres:17 on host port 5433).
# On Vercel: Neon pooled URL (-pooler host) for DATABASE_URL, direct URL for migrations.
DATABASE_URL=postgres://feast:feast@localhost:5433/feast
DATABASE_URL_UNPOOLED=postgres://feast:feast@localhost:5433/feast
# Used by `npm run test:db` and the workflow integration tests.
TEST_DATABASE_URL=postgres://feast:feast@localhost:5433/feast_test

# HS256 signing key for device bearer tokens (>= 32 random bytes).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=change-me-cron
# `Authorization: Bearer $ADMIN_SECRET` for /api/admin/*.
ADMIN_SECRET=change-me-admin

# Dev only: GET /api/v1/dev/today-alarm reveals the unfired alarm. Never true in production.
DEV_REVEAL_ALARM=false

# Max POST /api/v1/auth/register calls per client IP per hour.
REGISTER_RATE_LIMIT_PER_HOUR=30

# Optional: Slack/email webhook paged when no alarm has fired by 20:45 Denver.
ALERT_WEBHOOK_URL=

# APNs (token auth). APNS_DRY_RUN=true skips the network and records dry_run deliveries.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_P8_BASE64=
APNS_BUNDLE_ID=com.valiflo.feastdaily
APNS_ENV=sandbox
APNS_DRY_RUN=true
